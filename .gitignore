# binarios compilados
*.exe
*.dll
*.so
*.dylib

# saidas de teste e perfil
*.test
*.out
*.prof

# pesos de modelo: nunca versionar
*.onnx
models/

# dados de mapa: nunca versionar, sao centenas de MB e tem licenca propria
*.pbf
*.osm
*.eramap
dados/

# rascunho de sessao: varias sessoes trabalham nesta mesma arvore, e
# arquivo solto na raiz acaba varrido para o commit de outra pessoa
.tmp-*/
.tmp-*

# ambiente
.env
.DS_Store
